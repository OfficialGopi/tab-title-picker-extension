{
  "manifest_version": 3,
  "name": "Tab Title Picker",
  "version": "1.0",
  "description": "Fetches the title of the current tab and shows it in popup.",
  "permissions": ["tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.jpg",
    "48": "icon.jpg",
    "128": "icon.jpg"
  },
  "background": {}
}
